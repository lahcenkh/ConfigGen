! Trunk configuration for {{ trunk.switch }}
! {{ trunk.vlan_count }} VLANs — generated by {{ trunk.generated_by }}
!
interface {{ trunk.uplink_port }}
  description {{ trunk.description }}
  switchport mode trunk
  switchport trunk allowed vlan {% for v in trunk.vlans %}{{ v.id }}{% if not loop.last %},{% endif %}{% endfor %}
!
{% for v in trunk.vlans %}
interface Vlan{{ v.id }}
  description {{ v.name }}
  ip address {{ v.gateway }} {{ v.subnet }}
!
{% endfor %}